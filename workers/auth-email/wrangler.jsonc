{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pack3963-auth-email",
  "main": "../../cloudflare/pack3963-auth-email/worker.js",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "FROM_EMAIL": "Cub Scout Pack 3963 <portal@pack3963.com>",
    "SUPPORT_EMAIL": "cubscouts3963@gmail.com",
    "LINK_TTL_MINUTES": "60",
    "SUPABASE_URL": "https://buvrqioskjjhszqkpypa.supabase.co"
  }
}
